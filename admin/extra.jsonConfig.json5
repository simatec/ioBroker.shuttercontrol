{
    type: 'panel',
    label: 'Extra Settings',
    items: {
        _header: {
            type: 'header',
            text: 'Extra Settings',
            size: 2,
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _astro: {
            type: 'panel',
            label: 'Astro settings',
            collapsable: true,
            color: 'primary',
            items: {
                _coordinates: {
                    type: 'coordinates',
                    latitudeName: 'latitude',
                    longitudeName: 'longitude',
                    xs: 12,
                    sm: 12,
                    md: 12,
                    lg: 8,
                    xl: 6,
                },
                _coordinatesInfo: {
                    type: 'staticText',
                    text: 'If latitude and longitude are empty, the position from the system settings is used',
                    style: {
                        fontSize: 12,
                        opacity: 0.7,
                    },
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                sunProtEndElevation: {
                    type: 'number',
                    label: 'Sun Protect End with Elevation',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    step: 0.1,
                    unit: '°',
                    newLine: true,
                },
                astroDelayUp: {
                    type: 'number',
                    label: 'Time delay for Driving up (minutes)',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    newLine: true,
                },
                astroDelayDown: {
                    type: 'number',
                    label: 'Time delay for Driving down (minutes)',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                driveDelayUpAstro: {
                    type: 'number',
                    label: 'Time delay for driving the shutters (seconds)',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
            },
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _summer: {
            type: 'panel',
            label: 'summer settings',
            collapsable: true,
            color: 'primary',
            items: {
                SummerStart: {
                    type: 'text',
                    label: 'SummerStart',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    help: 'Format: DD.MM.',
                    validator: '/^\\d{2}\\.\\d{2}\\.?$/.test(data.SummerStart)',
                    validatorErrorText: 'Format: DD.MM.',
                },
                SummerEnd: {
                    type: 'text',
                    label: 'SummerEnd',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    help: 'Format: DD.MM.',
                    validator: '/^\\d{2}\\.\\d{2}\\.?$/.test(data.SummerEnd)',
                    validatorErrorText: 'Format: DD.MM.',
                },
            },
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _xmas: {
            type: 'panel',
            label: 'xmas settings',
            collapsable: true,
            color: 'primary',
            items: {
                XMasStart: {
                    type: 'text',
                    label: 'XMasStart',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    help: 'Format: DD.MM.',
                    validator: '/^\\d{2}\\.\\d{2}\\.?$/.test(data.XMasStart)',
                    validatorErrorText: 'Format: DD.MM.',
                },
                XMasEnd: {
                    type: 'text',
                    label: 'XMasEnd',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    help: 'Format: DD.MM.',
                    validator: '/^\\d{2}\\.\\d{2}\\.?$/.test(data.XMasEnd)',
                    validatorErrorText: 'Format: DD.MM.',
                },
            },
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _holiday: {
            type: 'panel',
            label: 'holiday settings',
            collapsable: true,
            color: 'primary',
            items: {
                publicHolidays: {
                    type: 'checkbox',
                    label: 'Use public holidays',
                    xs: 12,
                    sm: 12,
                    md: 12,
                    lg: 12,
                    xl: 12,
                },
                publicHolInstance: {
                    type: 'instance',
                    adapter: 'feiertage',
                    label: 'public holidays Instance',
                    hidden: '!data.publicHolidays',
                    newLine: true,
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                HolidayDP: {
                    type: 'objectId',
                    label: 'Object ID for holiday today',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    newLine: true,
                },
            },
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _lightsensor: {
            type: 'panel',
            label: 'lightsensor settings',
            collapsable: true,
            color: 'primary',
            items: {
                lightsensorDown: {
                    type: 'number',
                    label: 'Brightness value for down with lightsensor',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    unit: 'lux',
                },
                lightsensorUp: {
                    type: 'number',
                    label: 'Brightness value for up with lightsensor',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    unit: 'lux',
                },
                lightsensorUpTime: {
                    type: 'timePicker',
                    label: 'earliest time for opening with light sensor',
                    format: 'HH:mm',
                    returnFormat: 'HH:mm',
                    views: [
                        'hours',
                        'minutes',
                    ],
                    timeSteps: {
                        hours: 1,
                        minutes: 1,
                    },
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    newLine: true,
                },
                lightsensorDownTime: {
                    type: 'timePicker',
                    label: 'earliest time for closing with light sensor',
                    format: 'HH:mm',
                    returnFormat: 'HH:mm',
                    views: [
                        'hours',
                        'minutes',
                    ],
                    timeSteps: {
                        hours: 1,
                        minutes: 1,
                    },
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                lightsensorUpDown: {
                    type: 'objectId',
                    label: 'Object ID for Lightsensor',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    newLine: true,
                },
            },
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _schoolfree: {
            type: 'panel',
            label: 'schoolfree settings',
            collapsable: true,
            color: 'primary',
            items: {
                schoolfree: {
                    type: 'checkbox',
                    label: 'Use the Schoolfree adapter',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                schoolfreeInstance: {
                    type: 'instance',
                    adapter: 'schoolfree',
                    label: 'schoolfree Instance',
                    hidden: '!data.schoolfree',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                schoolfreeDP: {
                    type: 'objectId',
                    label: 'Object ID to activate / deactivate the school holidays',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    hidden: 'data.schoolfree',
                },
                schoolfreeChildrenArea: {
                    type: 'checkbox',
                    label: 'Use schoolfree for Children Area',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    newLine: true,
                },
                schoolfreeSleepArea: {
                    type: 'checkbox',
                    label: 'Use schoolfree for Sleep Area',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                schoolfreeLivingArea: {
                    type: 'checkbox',
                    label: 'Use schoolfree for Living Area',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
            },
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _special: {
            type: 'panel',
            label: 'Special times',
            collapsable: true,
            color: 'primary',
            items: {
                LateAllDown: {
                    type: 'checkbox',
                    label: 'close certain shutters later (the individual shutters must be activated in the shutter settings)',
                    xs: 12,
                    sm: 12,
                    md: 12,
                    lg: 12,
                    xl: 12,
                },
                LateAllDownTime: {
                    type: 'timePicker',
                    label: 'Time at which the roller shutters configured for this should close late',
                    format: 'HH:mm',
                    returnFormat: 'HH:mm',
                    views: [
                        'hours',
                        'minutes',
                    ],
                    timeSteps: {
                        hours: 1,
                        minutes: 1,
                    },
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    hidden: '!data.LateAllDown',
                    newLine: true,
                },
                betweenPositionTime: {
                    type: 'timePicker',
                    label: 'Time to completely close the shutters from the intermediate position',
                    format: 'HH:mm',
                    returnFormat: 'HH:mm',
                    views: [
                        'hours',
                        'minutes',
                    ],
                    timeSteps: {
                        hours: 1,
                        minutes: 1,
                    },
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                noGoTime: {
                    type: 'number',
                    label: 'Time left to detect second sleep (minutes)',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                satIsWeek: {
                    type: 'checkbox',
                    label: 'Saturday is working week',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    newLine: true,
                },
            },
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _extraSettings: {
            type: 'panel',
            label: 'Extra Settings',
            collapsable: true,
            color: 'primary',
            items: {
                currentShutterState: {
                    type: 'checkbox',
                    label: 'check current Shutter State',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                currentShutterStateTime: {
                    type: 'number',
                    label: 'Waiting time for checking the shutter status (seconds)',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    hidden: '!data.currentShutterState',
                },
                blockManuMode: {
                    type: 'checkbox',
                    label: 'Blocking the Manu mode for known shutter heights',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    newLine: true,
                },
                shutterStateRound: {
                    type: 'select',
                    label: 'Rounding up or down the current shutter heights',
                    options: [
                        {
                            label: 'off',
                            value: 1,
                        },
                        {
                            label: 'on 5s rounds',
                            value: 5,
                        },
                        {
                            label: 'on 10s rounds',
                            value: 10,
                        },
                    ],
                    newLine: true,
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                triggerAutoSleep: {
                    type: 'objectId',
                    label: 'Object ID of trigger for Auto Sleep',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    newLine: true,
                },
                triggerAutoLiving: {
                    type: 'objectId',
                    label: 'Object ID of trigger for Auto Living',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                triggerAutoChildren: {
                    type: 'objectId',
                    label: 'Object ID of trigger for Auto Children',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
            },
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _alarm: {
            type: 'panel',
            label: 'Alarm Settings',
            collapsable: true,
            color: 'primary',
            items: {
                alarmWind1Level: {
                    type: 'number',
                    label: 'Alarm Wind 1 Level',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    unit: '%',
                    newLine: true,
                },
                alarmWind1: {
                    type: 'objectId',
                    label: 'Object ID of alarm wind 1',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                alarmWind2Level: {
                    type: 'number',
                    label: 'Alarm Wind 2 Level',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    unit: '%',
                    newLine: true,
                },
                alarmWind2: {
                    type: 'objectId',
                    label: 'Object ID of alarm wind 2',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                alarmRainLevel: {
                    type: 'number',
                    label: 'Alarm Rain Level',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    unit: '%',
                    newLine: true,
                },
                alarmRain: {
                    type: 'objectId',
                    label: 'Object ID of alarm Rain',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                alarmFrostLevel: {
                    type: 'number',
                    label: 'Alarm Frost Level',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    unit: '%',
                    newLine: true,
                },
                alarmFrost: {
                    type: 'objectId',
                    label: 'Object ID of alarm Frost',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                alarmFireLevel: {
                    type: 'number',
                    label: 'Alarm Fire Level',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    unit: '%',
                    newLine: true,
                },
                alarmFire: {
                    type: 'objectId',
                    label: 'Object ID of alarm Fire',
                    types: 'state',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
            },
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
    },
}
