{
    type: 'panel',
    label: 'Time Settings',
    items: {
        _header: {
            type: 'header',
            text: 'Time Settings',
            size: 2,
            xs: 12,
            sm: 12,
            md: 12,
            lg: 12,
            xl: 12,
        },
        _living: {
            type: 'panel',
            label: 'Settings for Livingarea',
            collapsable: true,
            color: 'primary',
            items: {
                livingAutomatic: {
                    type: 'select',
                    label: 'Automatic for living area',
                    options: [
                        {
                            label: 'only living area time',
                            value: 'livingTime',
                        },
                        {
                            label: 'automatic living area time with sunrise and sunset',
                            value: 'livingSunriseSunset',
                        },
                        {
                            label: 'automatic living area time with Golden hour',
                            value: 'livingGoldenHour',
                        },
                    ],
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                W_shutterDownLiving: {
                    type: 'timePicker',
                    label: 'Shut down on the week',
                    format: 'HH:mm',
                    returnFormat: 'HH:mm',
                    views: [
                        'hours',
                        'minutes',
                    ],
                    timeSteps: {
                        hours: 1,
                        minutes: 1,
                    },
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    newLine: true,
                },
                W_shutterUpLivingMin: {
                    type: 'timePicker',
                    label: 'Min Time for Driving up on the week',
                    format: 'HH:mm',
                    returnFormat: 'HH:mm',
                    views: [
                        'hours',
                        'minutes',
                    ],
                    timeSteps: {
                        hours: 1,
                        minutes: 1,
                    },
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                    hidden: 'data.livingAutomatic === \'livingTime\'',
                },
                W_shutterUpLivingMax: {
                    type: 'timePicker',
                    label: 'Max Time for Driving up on the week',
                    format: 'HH:mm',
                    returnFormat: 'HH:mm',
                    views: [
                        'hours',
                        'minutes',
                    ],
                    timeSteps: {
                        hours: 1,
                        minutes: 1,
                    },
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                driveDelayUpLiving: {
                    type: 'number',
                    label: 'Time delay for driving the shutters (seconds)',
                    xs: 12,
                    sm: 12,
                    md: 6,
                    lg: 4,
                    xl: 4,
                },
                WE_shutterDownLiving: {
                    type: 'timePicker',
                    label: 'Shut down on the weekend',
                    format: 'HH:mm',
                    returnFormat: 'HH:mm',
                    views: [
                        'hours',
